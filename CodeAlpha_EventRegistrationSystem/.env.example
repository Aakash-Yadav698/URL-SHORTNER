PORT=8081

# Organizer (admin) password for creating/deleting events
ADMIN_PASSWORD=admin123

# Database: "sqlite" (default, zero setup) or "mysql"
DB_DIALECT=sqlite

# Only needed when DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=event_registration_db
DB_USER=root
DB_PASSWORD=your_mysql_password
